---
/**
 * 사이트 헤더.
 * - 앱 셸을 쓰는 페이지에서만 좌/우 패널 토글을 표시한다(withToggles).
 * - 좌측 네비게이션 패널이 경로 목록을 담당하므로 헤더에는 링크를 두지 않는다.
 */
import { SITE } from '../../data/site';
import ThemeToggle from '../ThemeToggle.astro';

interface Props {
  withToggles?: boolean;
}

const { withToggles = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    {
      withToggles && (
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="true"
          aria-controls="site-nav"
          aria-label="사이드바 열기/접기"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M9 3v18"></path>
          </svg>
        </button>
      )
    }

    <a class="site-header__brand" href="/">{SITE.title}</a>

    <ThemeToggle />

    {
      withToggles && (
        <button
          type="button"
          class="panel-toggle"
          data-panel-toggle
          aria-expanded="false"
          aria-controls="article-panel"
          aria-label="보조 자료 패널 열기/접기"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M15 3v18"></path>
          </svg>
        </button>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-panel);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    min-height: 3.5rem;
  }
  .site-header__brand {
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-decoration: none;
    margin-inline-end: auto;
  }
</style>
