---
/**
 * 우측 패널 내용 (PLAN 9.3 / D7)
 * 탭 ① 문서 안내(목차 + scrollspy) ② 자료(materials[])
 *
 * 동작(스크립트):
 *  - 탭 전환 상태를 localStorage 에 저장
 *  - 본문의 [data-material-ref] 클릭 → 자료 탭으로 전환 + 해당 항목 강조/스크롤
 *  - 자료의 '본문에서 보기' 클릭 → 본문의 참조 위치로 스크롤
 *  - 목차 scrollspy (IntersectionObserver)
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  materials: CollectionEntry<'blog'>['data']['materials'];
  headings: { depth: number; slug: string; text: string }[];
}

const { materials = [], headings = [] } = Astro.props;

// 자료 번호(1부터)를 부여하고 그룹 순서를 보존한다
const indexed = materials.map((m, i) => ({ ...m, n: i + 1 }));
const groups = [...new Set(indexed.map((m) => m.group ?? '자료'))];
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<div id="material-panel">
  <div class="panel-tabs" role="tablist" aria-label="패널 보기 전환">
  <button
    type="button"
    role="tab"
    id="tab-toc"
    data-panel-tab="toc"
    aria-controls="view-toc"
    aria-selected="true"
    class="panel-tab"
  >
    문서 안내
  </button>
  <button
    type="button"
    role="tab"
    id="tab-materials"
    data-panel-tab="materials"
    aria-controls="view-materials"
    aria-selected="false"
    class="panel-tab"
    tabindex="-1"
  >
    자료
    <span class="panel-tab__count">{indexed.length}</span>
  </button>
</div>

<div class="panel-views">
  <section id="view-toc" data-panel-view="toc" role="tabpanel" aria-labelledby="tab-toc">
    {
      tocItems.length === 0 ? (
        <p class="panel-empty">이 문서에는 소제목이 없습니다.</p>
      ) : (
        <ol class="toc-list">
          {tocItems.map((h) => (
            <li class={h.depth === 3 ? 'toc-item toc-item--sub' : 'toc-item'}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section
    id="view-materials"
    data-panel-view="materials"
    role="tabpanel"
    aria-labelledby="tab-materials"
    hidden
  >
    {
      indexed.length === 0 ? (
        <p class="panel-empty">이 글에는 등록된 보조 자료가 없습니다.</p>
      ) : (
        <>
          {/* 인쇄 시에만 보이는 부록 제목 (panel-spec 5.5) */}
          <h2 class="materials-appendix-title">부록: 보조 자료</h2>

          {groups.length > 1 && (
            <div class="group-filter" role="group" aria-label="자료 그룹">
              {groups.map((g, i) => (
                <button
                  type="button"
                  class="group-chip"
                  data-group-filter={g}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {g}
                </button>
              ))}
            </div>
          )}

          <div class="materials-list" data-materials-list>
            {
              indexed.map((m) => (
                <article
              class="material"
              id={`material-${m.id}`}
              data-material-id={m.id}
              data-material-group={m.group ?? '자료'}
            >
              <header class="material__header">
                <span class="material__index" aria-hidden="true">
                  {m.n}
                </span>
                <h3 class="material__title">{m.title}</h3>
                <button
                  type="button"
                  class="material__back"
                  data-material-back={m.id}
                  title="본문에서 보기"
                  aria-label={`본문의 ${m.n}번 참조로 이동`}
                >
                  ↩
                </button>
              </header>

              {
                m.type === 'image' && m.src && (
                  <button
                    type="button"
                    class="material__media"
                    data-lightbox-src={m.src}
                    data-lightbox-alt={m.alt ?? ''}
                    data-lightbox-caption={m.caption ?? ''}
                    aria-label={`${m.title} 확대 보기`}
                  >
                    <img
                      src={m.src}
                      alt={m.alt ?? ''}
                      width={m.width}
                      height={m.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                )
              }

              {m.type === 'link' && m.href && (
                <p class="material__link">
                  <a href={m.href} target="_blank" rel="noreferrer">
                    {m.href}
                  </a>
                </p>
              )}

              {m.type === 'note' && m.body && <p class="material__note">{m.body}</p>}

              {m.caption && <p class="material__caption">{m.caption}</p>}
              {m.source && <p class="material__source">출처: {m.source}</p>}
            </article>
          ))
            }
          </div>
        </>
      )
    }
  </section>
  </div>
</div>

<script>
  function initPanel(): void {
    const root = document.getElementById('material-panel');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-panel-tab]'));
    const views = Array.from(root.querySelectorAll<HTMLElement>('[data-panel-view]'));
    const KEY = 'panel.tab';

    function selectTab(name: string, focus = false): void {
      tabs.forEach((tab) => {
        const on = tab.dataset.panelTab === name;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      views.forEach((view) => {
        view.hidden = view.dataset.panelView !== name;
      });
      try {
        localStorage.setItem(KEY, name);
      } catch {
        /* 무시 */
      }
      document.dispatchEvent(new CustomEvent('panel-tab-changed'));
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab.dataset.panelTab ?? 'toc'));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const dir = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        if (!next) return;
        selectTab(next.dataset.panelTab ?? 'toc', true);
      });
    });

    // 저장된 탭 복원 (자료가 있을 때만)
    try {
      const saved = localStorage.getItem(KEY);
      if (saved && tabs.some((t) => t.dataset.panelTab === saved)) selectTab(saved);
    } catch {
      /* 무시 */
    }

    // 그룹 필터
    const chips = Array.from(root.querySelectorAll<HTMLElement>('[data-group-filter]'));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const group = chip.dataset.groupFilter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        root.querySelectorAll<HTMLElement>('[data-material-group]').forEach((item) => {
          item.hidden = group !== 'all' && item.dataset.materialGroup !== group;
        });
        try {
          localStorage.setItem('panel.group', group ?? 'all');
        } catch {
          /* 무시 */
        }
        document.dispatchEvent(new CustomEvent('panel-filter-changed'));
      });
    });

    // 저장된 그룹 필터 복원
    try {
      const savedGroup = localStorage.getItem('panel.group');
      const chip = chips.find((c) => c.dataset.groupFilter === savedGroup);
      if (chip) {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        root.querySelectorAll<HTMLElement>('[data-material-group]').forEach((item) => {
          item.hidden =
            chip.dataset.groupFilter !== 'all' &&
            item.dataset.materialGroup !== chip.dataset.groupFilter;
        });
      }
    } catch {
      /* 무시 */
    }

    // 본문 → 패널
    document.querySelectorAll<HTMLElement>('[data-material-ref]').forEach((ref) => {
      ref.addEventListener('click', () => {
        const id = ref.dataset.materialRef;
        if (!id) return;
        selectTab('materials');
        const item = root.querySelector<HTMLElement>(`#material-${CSS.escape(id)}`);
        if (!item) return;
        // 그룹 필터에 가려져 있으면 되돌린다
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.groupFilter === 'all')));
        root.querySelectorAll<HTMLElement>('[data-material-group]').forEach((el) => {
          el.hidden = false;
        });
        document.dispatchEvent(new CustomEvent('open-panel'));
        item.classList.add('is-highlighted');
        item.scrollIntoView({ block: 'center', behavior: 'smooth' });
        window.setTimeout(() => item.classList.remove('is-highlighted'), 1600);
      });
    });

    // 패널 → 본문
    root.querySelectorAll<HTMLElement>('[data-material-back]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.materialBack;
        if (!id) return;
        const target = document.querySelector<HTMLElement>(`[data-material-ref="${CSS.escape(id)}"]`);
        target?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        target?.focus({ preventScroll: true });
      });
    });

    // 문서 목차 scrollspy
    const links = Array.from(root.querySelectorAll<HTMLElement>('[data-toc-link]'));
    if (links.length > 0 && 'IntersectionObserver' in window) {
      const byId = new Map(links.map((l) => [l.dataset.tocLink ?? '', l]));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const link = byId.get(entry.target.id);
            links.forEach((l) => l.removeAttribute('aria-current'));
            link?.setAttribute('aria-current', 'true');
          });
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 },
      );
      document.querySelectorAll('article.prose h2[id], article.prose h3[id]').forEach((h) => {
        observer.observe(h);
      });
    }
  }

  /**
   * 패널이 본문 옆에 고정(docked)일 때, 각 자료 카드를 본문의
   * `<FigureRef>` 위치와 평행하게 배치한다. (panel-spec 5.7)
   *
   *  · 카드 top 을 참조의 문서 오프셋에 맞추고, 겹치면 아래로 밀어낸다
   *  · 패널 스크롤을 페이지 스크롤에 선형으로 연동한다 → 항상 평행
   *  · 오버레이(<1024px)에서는 동작하지 않는다(기존 흐름 유지)
   */
  function initMaterialAlignment(): void {
    const list = document.querySelector<HTMLElement>('[data-materials-list]');
    const shell = document.getElementById('app-shell');
    const scroller = document.querySelector<HTMLElement>('.article-panel__inner');
    const view = document.querySelector<HTMLElement>('[data-panel-view="materials"]');
    const body = document.querySelector<HTMLElement>('.article__body');
    if (!list || !shell || !scroller || !view || !body) return;

    alignMaterials(list, shell, scroller, view, body);
  }

  function alignMaterials(
    list: HTMLElement,
    shell: HTMLElement,
    scroller: HTMLElement,
    view: HTMLElement,
    body: HTMLElement,
  ): void {
    const mqDesktop = window.matchMedia('(min-width: 1024px)');
    /** 카드 사이 최소 간격 */
    const GAP = 16;

    let aligned = false;
    let syncOffset = 0;
    let frame = 0;

    const cards = (): HTMLElement[] => Array.from(list.querySelectorAll<HTMLElement>('.material'));
    const isDocked = (): boolean => mqDesktop.matches && shell.dataset.panel === 'open';
    const isVisible = (): boolean => !view.hasAttribute('hidden');

    function clear(): void {
      aligned = false;
      list.removeAttribute('data-aligned');
      list.style.removeProperty('--list-h');
      cards().forEach((card) => card.style.removeProperty('--material-top'));
    }

    /** 페이지 스크롤에 패널 스크롤을 연동 (선형이라 항상 평행이 유지된다) */
    function sync(): void {
      if (!aligned) return;
      scroller.scrollTop = window.scrollY + syncOffset;
    }

    function align(): void {
      if (!isDocked() || !isVisible()) {
        clear();
        return;
      }

      // 본문의 참조 위치 수집 (같은 자료를 여러 번 참조하면 첫 번째를 기준)
      const refs = new Map<string, HTMLElement>();
      document.querySelectorAll<HTMLElement>('[data-material-ref]').forEach((el) => {
        const id = el.dataset.materialRef;
        if (id && !refs.has(id)) refs.set(id, el);
      });
      if (refs.size === 0) {
        clear();
        return;
      }

      const bodyTop = body.getBoundingClientRect().top + window.scrollY;
      const desired = new Map<string, number>();
      refs.forEach((el, id) => {
        desired.set(id, el.getBoundingClientRect().top + window.scrollY - bodyTop);
      });

      // 1) 절대 배치로 전환하고 각 카드의 top 을 계산
      list.setAttribute('data-aligned', 'true');
      let cursor = 0;
      let maxBottom = 0;
      cards().forEach((card) => {
        const id = card.dataset.materialId ?? '';
        const want = desired.get(id);
        const top = want === undefined ? cursor : Math.max(want, cursor);
        card.style.setProperty('--material-top', `${Math.round(top)}px`);
        const height = card.getBoundingClientRect().height;
        cursor = top + height + GAP;
        maxBottom = Math.max(maxBottom, top + height);
      });
      // 마지막 참조까지 스크롤이 닿도록 꼬리 여백을 둔다
      list.style.setProperty('--list-h', `${Math.round(maxBottom + scroller.clientHeight)}px`);

      // 2) 연동 기준값: 대응하는 참조가 있는 첫 카드로 계산
      const first = cards().find((card) => {
        const id = card.dataset.materialId ?? '';
        return !card.hidden && refs.has(id);
      });
      const firstRef = first ? refs.get(first.dataset.materialId ?? '') : undefined;
      if (!first || !firstRef) {
        clear();
        return;
      }

      const previous = scroller.scrollTop;
      scroller.scrollTop = 0;
      const cardOffset = first.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
      const refTop = firstRef.getBoundingClientRect().top;
      scroller.scrollTop = previous;

      syncOffset = cardOffset - refTop - window.scrollY;
      aligned = true;
      sync();
    }

    function scheduleAlign(): void {
      if (frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        frame = 0;
        align();
      });
    }

    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', scheduleAlign);
    window.addEventListener('load', scheduleAlign);
    mqDesktop.addEventListener('change', scheduleAlign);
    document.addEventListener('shell-rendered', scheduleAlign);
    document.addEventListener('panel-width-changed', scheduleAlign);
    document.addEventListener('panel-tab-changed', scheduleAlign);
    document.addEventListener('panel-filter-changed', scheduleAlign);
    void document.fonts?.ready.then(scheduleAlign);

    scheduleAlign();
  }

  initPanel();
  initMaterialAlignment();
</script>
